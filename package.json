{
  "name": "ap3-typescript",
  "version": "6.0.0",
  "description": "AP3 - Aplikasi Penyusunan Penelitian Perkara (Versi Node.js, Express & TypeScript dengan Basis Data SQLite)",
  "type": "module",
  "main": "dist/server/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.server.json && tsc -p tsconfig.client.json",
    "build:server": "tsc -p tsconfig.server.json",
    "build:client": "tsc -p tsconfig.client.json",
    "start": "node dist/server/index.js",
    "dev": "node --loader ts-node/esm src/server/index.ts",
    "preview": "node dist/server/index.js"
  },
  "keywords": [
    "ap3",
    "penelitian-perkara",
    "bea-cukai",
    "typescript",
    "nodejs",
    "sqlite",
    "express"
  ],
  "author": "Direktorat Jenderal Bea dan Cukai",
  "license": "ISC",
  "dependencies": {
    "better-sqlite3": "^9.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.9",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.12.7",
    "nodemon": "^3.1.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.5",
    "vite": "^5.2.8"
  }
}
